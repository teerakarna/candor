{
  "title": "Candor Overview",
  "uid": "candor-overview",
  "tags": [
    "candor"
  ],
  "schemaVersion": 39,
  "version": 15,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values({__name__=~\"candor_findings_current|candor_signalpolicy_budget_calls_limit\"}, namespace)",
        "current": {
          "value": "$__all",
          "text": "All"
        },
        "includeAll": true,
        "multi": false,
        "hide": 0,
        "refresh": 2,
        "regex": "",
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 50,
      "title": "",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "**Candor** finds security problems in your cluster and opens fix pull requests. This page shows how that is going: what is open, whether it is getting fixed, what it costs, and whether the tool itself is healthy. The Namespace filter applies to open findings, the fix pull request list and AI budget; everything else is cluster-wide. [Docs](https://github.com/teerakarna/candor) - [Report an issue](https://github.com/teerakarna/candor/issues/new)"
      }
    },
    {
      "id": 20,
      "title": "Where we stand",
      "description": "What needs attention right now, and what has been dealt with, per severity. Open is a live count; Fixed and Came back are 7-day totals.",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
