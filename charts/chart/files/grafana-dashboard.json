    {
      "id": 25,
      "title": "Fix pull requests to review",
      "description": "Open fix pull requests Candor has proposed, for a human to review and merge. Each row is one finding; the link opens its pull request.",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 26,
      "title": "Open fix pull requests",
      "description": "candor_finding_pull_request_info. One row per open finding with a proposed fix pull request, most severe first. A finding drops off the list when it is resolved. Follows the Namespace filter.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "noValue": "No open fix pull requests",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Pull request"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open pull request",
                    "url": "${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Namespace"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Finding"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 260
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "rank"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "rank": true,
              "customresource_group": true,
              "customresource_kind": true,
              "customresource_version": true
            },
            "renameByName": {
              "namespace": "Namespace",
              "finding": "Finding",
              "severity": "Severity",
              "url": "Pull request"
            },
            "indexByName": {
              "severity": 0,
              "namespace": 1,
              "finding": 2,
              "url": 3
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "range": false,
          "format": "table",
          "expr": "label_replace(label_replace(label_replace(label_replace(candor_finding_pull_request_info{namespace=~\"$namespace\"}, \"rank\", \"1\", \"severity\", \"CRITICAL\"), \"rank\", \"2\", \"severity\", \"HIGH\"), \"rank\", \"3\", \"severity\", \"MEDIUM\"), \"rank\", \"4\", \"severity\", \"LOW\")"
        }
      ]
    },
    {
      "id": 22,
      "title": "What it costs",
      "description": "How much Candor leans on the AI, and how often it avoids doing so. Token counts are not recorded yet, so calls are the closest measure.",
      "type": "row",
      "collapsed": false,
