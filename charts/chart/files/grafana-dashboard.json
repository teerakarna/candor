{
  "title": "Candor Overview",
  "uid": "candor-overview",
  "tags": [
    "candor"
  ],
  "schemaVersion": 39,
  "version": 8,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values({__name__=~\"candor_findings_current|candor_signalpolicy_budget_calls_limit\"}, namespace)",
        "current": {
          "value": "$__all",
          "text": "All"
        },
        "includeAll": true,
        "multi": false,
        "hide": 0,
        "refresh": 2,
        "regex": "",
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 50,
      "title": "",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Candor** - signal-driven, cost-accountable Kubernetes operator. **Outstanding** (top row below) is what needs attention right now, by severity. **Resolved (7d)** / **Recurred (7d)** are the last week's history - a Finding that recurred was Resolved and came back. \"Cost & Operator Health\" below is Candor's own self-observability, not a finding about your cluster. [Docs](https://github.com/teerakarna/candor) - [Report an issue](https://github.com/teerakarna/candor/issues/new) The **Namespace** filter above applies to Outstanding and Budget Usage only - Resolved/Recurred, Verification Transitions, LLM Calls, and Enrichment Skipped are cluster-wide metrics today, not scoped per namespace."
      }
    },
    {
      "id": 20,
      "title": "Findings Status",
      "description": "What needs attention right now, and what's been taken care of, per severity. Outstanding is candor_findings_current, a live count recomputed on every scrape; Resolved and Recurring are 7-day totals.",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 111,
      "title": "Critical",
      "description": "Live count (candor_findings_current), excluding Resolved - needs action.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "wideLayout": false,
        "text": {
          "valueSize": 32
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "range": false,
          "expr": "sum(candor_findings_current{severity=\"CRITICAL\", outcome!=\"Resolved\", namespace=~\"$namespace\"}) or vector(0)",
          "legendFormat": "Outstanding"
        }
      ]
    },
