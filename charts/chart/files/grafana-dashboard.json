    {
      "id": 3,
      "title": "Findings detected, fixed and came back",
      "description": "candor_verification_transitions_total. Detected: a finding was first seen or seen again. Fixed: a later re-check no longer found it. Came back: it was fixed and then reappeared. Counts per hour, summed over all severities.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "per hour",
            "showPoints": "never",
            "lineWidth": 1,
            "fillOpacity": 6
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(candor_verification_transitions_total{outcome=\"still_present\"}[5m])) * 3600",
